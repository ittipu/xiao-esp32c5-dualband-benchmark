// ============================================================================
//  arduino_secrets.h.example  —  credential template (safe to commit)
//
//  SETUP:
//    1. Copy this file to  arduino_secrets.h  (same folder)
//    2. Fill in your own Wi-Fi details below
//    3. arduino_secrets.h is git-ignored, so your password never gets committed
//
//  Split-SSID router (one name per band)?  Put each band's name below.
//  Single dual-band SSID?  Put the SAME name in both fields.
// ============================================================================
#pragma once

#define SECRET_WIFI_SSID_24  "YOUR_2G_SSID"       // 2.4 GHz network name
#define SECRET_WIFI_SSID_5   "YOUR_5G_SSID"       // 5 GHz  network name
#define SECRET_WIFI_PASS     "YOUR_WIFI_PASSWORD" // same password on both bands
